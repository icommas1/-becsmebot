{
  "name": "becsbot",
  "version": "0.1.0",
  "private": true,
  "description": "BecsBot Solana trading service",
  "main": "src/basket.js",
  "scripts": {
    "start": "node src/basket.js",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:mobile": "playwright test",
    "test:smoke": "node scripts/smoke.js",
    "verify:storage": "node scripts/verify-storage.js",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test && npm run test:mobile"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "bs58": "^6.0.0",
    "dotenv": "^18.0.4",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
