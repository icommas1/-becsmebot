{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "becs-research",
  "definitions": {
    "timestamp": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$","maxLength":30},
    "reader": {"type":"string","enum":["exa","parallel"]},
    "request": {"type":"object","additionalProperties":false,"required":["query","providers"],"properties":{
      "query":{"type":"string","minLength":3,"maxLength":240,"pattern":"^[^\\u0000-\\u001f\\u007f]+$"},
      "providers":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/definitions/reader"}}
    }},
    "document": {"type":"object","additionalProperties":false,"required":["id","url","title","excerpt","host","retrievedAt","readers"],"properties":{
      "id":{"type":"string","pattern":"^[a-f0-9]{24}$"},
      "url":{"type":"string","pattern":"^https://","maxLength":2048},
      "title":{"type":"string","maxLength":240},"excerpt":{"type":"string","maxLength":1600},
      "host":{"type":"string","maxLength":253},"retrievedAt":{"$ref":"#/definitions/timestamp"},
      "readers":{"type":"array","minItems":1,"maxItems":2,"uniqueItems":true,"items":{"$ref":"#/definitions/reader"}}
    }},
    "response": {"type":"object","additionalProperties":false,"required":["query","retrievedAt","cached","executionEnabled","providers","documentCount","distinctHosts","documents","note"],"properties":{
      "query":{"type":"string","minLength":3,"maxLength":240},"retrievedAt":{"$ref":"#/definitions/timestamp"},
      "cached":{"type":"boolean"},"executionEnabled":{"const":false},
      "providers":{"type":"array","minItems":1,"maxItems":2,"items":{"type":"object","additionalProperties":false,"required":["id","status","error","documentCount"],"properties":{
        "id":{"$ref":"#/definitions/reader"},"status":{"enum":["ready","limited","unavailable"]},"error":{"type":["string","null"],"maxLength":400},"documentCount":{"type":"integer","minimum":0,"maximum":6}
      }}},
      "documentCount":{"type":"integer","minimum":0,"maximum":12},"distinctHosts":{"type":"integer","minimum":0,"maximum":12},
      "documents":{"type":"array","maxItems":12,"items":{"$ref":"#/definitions/document"}},"note":{"type":"string","maxLength":400}
    }},
    "status": {"type":"object","additionalProperties":false,"required":["executionEnabled","paidFallback","storage","onDemand","running","limits","catalog","ownerSignInRequired","accountEnabled"],"properties":{
      "executionEnabled":{"const":false},"paidFallback":{"const":false},"storage":{"const":"memory-only"},"onDemand":{"const":true},"running":{"type":"boolean"},"ownerSignInRequired":{"const":true},"accountEnabled":{"type":"boolean"},
      "limits":{"type":"object","additionalProperties":false,"required":["runsPerDay","cacheSeconds"],"properties":{"runsPerDay":{"type":"integer","minimum":1},"cacheSeconds":{"type":"number","minimum":0}}},
      "catalog":{"type":"array","minItems":8,"maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["id","name","role","kind","access","note","status"],"properties":{
        "id":{"enum":["exa","parallel","google-drive","gsc-wizard","github","railway","magicpath","supabase"]},"name":{"type":"string","maxLength":50},"role":{"type":"string","maxLength":100},"kind":{"enum":["reader","support"]},"access":{"type":"string","maxLength":100},"note":{"type":"string","maxLength":300},"status":{"enum":["untested","ready","limited","unavailable","support-only"]},"lastSuccessAt":{"anyOf":[{"$ref":"#/definitions/timestamp"},{"type":"null"}]},"lastError":{"type":["string","null"],"maxLength":400}
      }}}
    }}
  }
}
