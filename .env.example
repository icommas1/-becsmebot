# Make .env from this file. NEVER commit .env or session files.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Required for encrypted personal session storage. Generate a random 48+ character value.
BECS_SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
# Username of this project's bot, without @. Required for invitation links.
BECS_TELEGRAM_BOT_USERNAME=
BECS_ALLOWED_TELEGRAM_ID=
BECS_ADMIN_TOKEN=
BECS_MINI_APP_URL=
# Empty by default: serve the frontend and /api on the same origin.
# For a separately hosted frontend, list its exact HTTPS origins, comma separated.
BECS_FRONTEND_ORIGINS=
BECS_PROJECT_NAME=BecsAutoForward
# Optional: Google Gemini free-tier API key; check provider quota/privacy terms
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Optional overrides
# BECS_DB_PATH=./data/becs.sqlite
# BECS_SESSION_DIR=./data/sessions

# Local loopback-only unauthenticated development, never enable in production.
# BECS_DEV_MODE=1
