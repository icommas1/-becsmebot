# Required server-side Jupiter key. Never add a wallet key to this paper-only app.
JUPITER_API_KEY=
# Optional HTTP port; Railway supplies this automatically.
PORT=3000
# Optional persistent history directory. Railway uses the mounted volume path; local development can use ./data.
DATA_DIR=./data

# Optional private server paper account. Keep false until every field is set.
PAPER_ACCOUNTS_ENABLED=false
# Use Railway private reference: ${{Postgres.DATABASE_URL}}
DATABASE_URL=
PUBLIC_ORIGIN=https://becsbot-production.up.railway.app
# GitHub OAuth App callback: PUBLIC_ORIGIN/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Numeric GitHub ID permitted to sign in (not username).
PAPER_GITHUB_USER_ID=
# Optional read-only Smart Money intelligence. No live execution is enabled.
# Nansen API is the first structured provider; leave blank to disable wallet intelligence polling.
NANSEN_API_KEY=
# Optional polling interval, 15 seconds to 1 hour. Default: 60000.
WALLET_INTEL_SCAN_MS=60000

# Permanent append-only research archive. When enabled, every completed market scan is stored in PostgreSQL
# as an immutable content-addressed snapshot. Wallet-intelligence scans are archived when that provider is enabled.
RESEARCH_ARCHIVE_ENABLED=false
# Optional dedicated archive database. Leave blank to reuse DATABASE_URL.
RESEARCH_ARCHIVE_DATABASE_URL=
# Stable append-only stream identifier.
RESEARCH_ARCHIVE_STREAM_ID=becs-research-v1
